{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.js",
      "**/*.ts",
      "**/*.tsx",
      "**/*.css",
      "**/*.scss",
      "**/*.html",
      "**/*.json",
      "**/*.md",
      "!**/supabase/functions",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/ios",
      "!**/android",
      "!**/.git/",
      "!**/.vscode",
      "!**/*.d.ts",
      "!**/*.spec.ts",
      "!**/*.test.ts",
      "!**/.github",
      "!**/examples",
      "!**/tests"
    ]
  }
}
