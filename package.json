{
  "name": "@clhaas/palette-kit",
  "version": "0.1.1",
  "description": "Easy way to create the color palette of your app",
  "license": "MIT",
  "author": "Claus Haas",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "lint:biome": "biome check --unsafe --write",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
    "lint": "npm run lint:biome && npm run lint:md && npm run typecheck && npm run typecheck:tests",
    "update": "npx npm-check-updates -i"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "apca-w3": "^0.1.9",
    "colorjs.io": "^0.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/apca-w3": "^0.1.3",
    "markdownlint-cli": "^0.47.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
