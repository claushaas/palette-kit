{
  "name": "@claus/palette-kit",
  "version": "0.0.1",
  "description": "Easy way to create the color palette of your app",
  "license": "MIT",
  "author": "Claus Haas",
  "type": "module",
  "main": "index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:biome": "biome check .",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
    "lint": "npm run lint:biome && npm run lint:md && npm run typecheck",
    "update": "npx npm-check-updates -i"
  },
  "dependencies": {
    "apca-w3": "^0.1.9",
    "colorjs.io": "^0.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/apca-w3": "^0.1.3",
    "markdownlint-cli": "^0.47.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
