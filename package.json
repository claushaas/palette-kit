{
  "name": "@clhaas/palette-kit",
  "version": "0.3.0",
  "description": "Easy way to create the color palette of your app",
  "license": "MIT",
  "author": "Claus Haas",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "packageManager": "pnpm@10.33.2",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:biome": "biome check --unsafe --write",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --fix",
    "lint": "pnpm run lint:biome && pnpm run lint:md && pnpm run typecheck",
    "update": "pnpm dlx npm-check-updates -i"
  },
  "dependencies": {
    "apca-w3": "^0.1.9",
    "culori": "^4.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/apca-w3": "^0.1.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^25.6.0",
    "markdownlint-cli": "^0.48.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
