{
	"compilerOptions": {
		"declaration": true,
		"forceConsistentCasingInFileNames": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": ["node"]
	},
	"exclude": ["examples/**", "tests/**", "node_modules/**"],
	"include": ["src/**/*.ts", "src/**/*.ts"]
}
